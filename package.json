{
  "name": "haven-havelland",
  "type": "module",
  "private": true,
  "scripts": {
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "sb:components": "storyblok components pull --space 303510 --verbose",
    "sb:types": "storyblok types generate --space 303510 --strict",
    "dev": "npm run sb:components && npm run sb:types && nuxt dev --host",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'"
  },
  "dependencies": {
    "@netlify/functions": "^4.2.7",
    "@tailwindcss/vite": "^4.1.13",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^13.9.0",
    "gsap": "^3.13.0",
    "keen-slider": "^6.8.6",
    "lenis": "^1.3.11",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "^4.1.13",
    "vee-validate": "^4.15.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/device": "^3.2.4",
    "@nuxtjs/sitemap": "^7.4.7",
    "@storyblok/nuxt": "^8.1.3",
    "@types/mailchimp__mailchimp_marketing": "^3.0.21",
    "@types/node": "^24.6.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.36.0",
    "nuxt": "^4.1.2",
    "storyblok": "^4.6.6",
    "typescript": "^5.9.3",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.22"
  },
  "overrides": {
    "zod": "^4.1.11"
  }
}
