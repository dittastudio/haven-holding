{
  "name": "haven-havelland",
  "type": "module",
  "private": true,
  "scripts": {
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "sb:components": "storyblok components pull --space 303510 --verbose",
    "sb:types": "storyblok types generate --space 303510 --strict",
    "sb:generate": "npm run sb:components && npm run sb:types",
    "dev": "npm run sb:generate && nuxt dev --host 0.0.0.0",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.2.1",
    "gsap": "^3.14.2",
    "keen-slider": "^6.8.6",
    "lenis": "^1.3.21",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "^4.2.2",
    "vee-validate": "^4.15.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/device": "^4.0.0",
    "@nuxtjs/sitemap": "^8.0.11",
    "@storyblok/nuxt": "^10.1.1",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/node": "^25.5.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.1.0",
    "nuxt": "^4.4.2",
    "storyblok": "^4.16.7",
    "typescript": "^6.0.2",
    "vite-svg-loader": "^5.1.1",
    "vue": "^3.5.31"
  },
  "overrides": {
    "zod": "^4.3.6"
  }
}
